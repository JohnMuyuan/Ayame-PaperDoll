{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "JohnMuyuan",
    "HappyRespawnanchor (upstream Ayame PaperDoll)",
    "Lucun_Ji (original author of Extra Player Renderer)"
  ],
  "contributors": [
    "Fallen_Breath",
    "X-Green",
    "altrisi",
    "plusls",
    "pertaz",
    "LightgraycaAT"
  ],
  "contact": {
    "homepage": "${mod_homepage_url}",
    "sources": "${mod_fabric_sources_url}",
    "issues": "${mod_issues_url}"
  },
  "license": "${mod_license}",
  "icon": "assets/ayame_paperdoll/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.ayamemc.ayamepaperdoll.fabric.AyamePaperDollFabric"
    ],
    "modmenu": [
      "org.ayamemc.ayamepaperdoll.fabric.AyamePaperDollModMenuApiImpl"
    ]
  },
  "mixins": [
    "${mod_mixin_config}"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": [">=1.20.1", "<1.20.2"],
    "fabric-api": ">=${fabric_api_dependency_version}"
  },
  "suggests": {
    "modmenu": ">=${modmenu_version}"
  },
  "accessWidener": "ayame-paperdoll.accesswidener"
}